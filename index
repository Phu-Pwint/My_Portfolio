        function setLang(lang) {
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    el.innerText = translations[lang][key];
                    el.setAttribute('dir', 'ltr'); 
                }
            });

            document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
                const key = el.getAttribute('data-i18n-placeholder');
                if (translations[lang] && translations[lang][key]) {
                    el.placeholder = translations[lang][key];
                    el.setAttribute('dir', 'ltr');
                }
            });
            
            const dynName = document.getElementById('dynamicName');
            dynName.innerText = translations[lang].name;
            dynName.setAttribute('dir', 'ltr');
            
            document.documentElement.setAttribute('lang', lang);
            
            const buttons = document.querySelectorAll('.lang-btn');
            buttons.forEach(btn => {
                btn.classList.remove('text-white');
                btn.classList.add('text-gray-400');
            });
            document.querySelector(`.lang-btn[data-lang="${lang}"]`).classList.add('text-white');
            document.querySelector(`.lang-btn[data-lang="${lang}"]`).classList.remove('text-gray-400');

            const cvLink = document.getElementById('cv-link');
            if (cvLink && cvFiles[lang]) {
                cvLink.href = cvFiles[lang];
                cvLink.setAttribute('download', cvFiles[lang]);
            }
            
            const whLink = document.getElementById('wh-link');
            if (whLink && whFiles[lang]) {
                whLink.href = whFiles[lang];
                whLink.setAttribute('download', whFiles[lang]);
            }
        }

        function openModal(id) {
            const m = document.getElementById(id);
            if (!m) return;
            m.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        function closeModal(id) {
            const m = document.getElementById(id);
            if (!m) return;
            m.classList.remove('active');
            document.body.style.overflow = '';
        }

        window.onclick = function (event) {
            if (event.target.classList.contains('modal')) {
                closeModal(event.target.id);
            }
        };
        
        document.addEventListener('keydown', e => { 
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal.active').forEach(m => closeModal(m.id));
